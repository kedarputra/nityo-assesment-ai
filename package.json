{
  "name": "harbor-point",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:prepare": "tsx scripts/prepare-database.ts",
    "db:ingest": "tsx src/snapshot/cli.ts ingest",
    "db:reset": "tsx src/snapshot/cli.ts reset",
    "sandcastle": "make docker && pnpm dlx tsx .sandcastle/main.mts",
    "sandcastle:build-image": "sandcastle docker build-image --image-name sandcastle:harbor-point",
    "sandcastle:clean": "node .sandcastle/clean.mjs",
    "sandcastle:list": "node .sandcastle/tracker.mjs list --table",
    "sandcastle:list:json": "node .sandcastle/tracker.mjs list",
    "sandcastle:dry-run": "pnpm dlx tsx .sandcastle/main.mts --dry-run",
    "sandcastle:test": "node --test \".sandcastle/test/*.test.mjs\"",
    "sandcastle:slack-test": "node .sandcastle/slack-test.mjs",
    "db:seed-users": "tsx scripts/seed-users.ts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@node-rs/argon2": "^2.2.2",
    "@vercel/functions": "^3.11.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.61.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
