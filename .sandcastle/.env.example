# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agent use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an Anthropic API key instead — uncomment and fill in:
# ANTHROPIC_API_KEY=

# Issue tracker: none needed. Tasks are markdown files under
# grilled/ in this repository, so the tracker needs no token,
# no host and no network access.
# See docs/agents/issue-tracker.md

# Slack notifications (optional). Off while the webhook is empty.
# Make an incoming webhook: api.slack.com/apps > your app > Incoming Webhooks,
# then pick the channel. Host-side only: these never reach a sandbox.
SANDCASTLE_SLACK_WEBHOOK_URL=
# The events to send, comma-separated. Empty or "all" sends every one:
# run-start, round-start, round-error, round-end, full-check-start,
# full-check, allowance-spent, run-end, run-stopped
SANDCASTLE_SLACK_EVENTS=
# Put before each alert (round-error, a red full check, run-stopped,
# a run that ends early), e.g. <@U0123ABCD> or <!here>. Empty: no mention.
SANDCASTLE_SLACK_MENTION=
# The name a message gives this machine. Empty: the host name.
SANDCASTLE_SLACK_MACHINE=
