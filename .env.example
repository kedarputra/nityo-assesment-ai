# Every env var the app reads. Copy to .env.local and fill in; never commit values.
# On Vercel each is set twice, once for Production and once for Preview: production's values
# point at the Neon `main` branch and the production Anthropic workspace, preview's at the shared
# Neon `preview` branch and the preview workspace. See docs/deployment.md.

# Postgres connection string the app uses (the pooled URL on Neon).
DATABASE_URL=
# The direct URL, around Neon's pooler, for the migrations, the seeds and the Reset
# (`npm run db:prepare`, `db:migrate`, `db:reset`). Leave it empty for a local Postgres, which
# has no pooler: DATABASE_URL then serves both.
DATABASE_URL_UNPOOLED=

# Anthropic API key for the agent, from a workspace with its own monthly spend limit (production
# and preview use different workspaces). Never needed by tests or `make check`.
ANTHROPIC_API_KEY=
# The model the agent uses. Defaults to claude-opus-5-5 when unset.
ANTHROPIC_MODEL=

# The seeded logins, read by `npm run db:seed-users`, and by the deploy's `npm run db:prepare`
# when the database has no users yet. Passwords are at least 12 characters
# and are stored as argon2id hashes; rerunning the seed updates them.
SEED_REVIEWER_PASSWORD=
SEED_ADMIN_PASSWORD=
# The assessors' login: its username, password and role (reviewer or admin; default reviewer).
SEED_ASSESSOR_USERNAME=
SEED_ASSESSOR_PASSWORD=
SEED_ASSESSOR_ROLE=
