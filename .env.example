# Every env var the app reads. Copy to .env.local and fill in; never commit values.

# Postgres connection string (the pooled URL on Neon).
DATABASE_URL=

# Anthropic API key for the agent. Never needed by tests or `make check`.
ANTHROPIC_API_KEY=
# The model the agent uses. Defaults to claude-opus-5-5 when unset.
ANTHROPIC_MODEL=

# The seeded logins, read only by `npm run db:seed-users`. Passwords are at least 12 characters
# and are stored as argon2id hashes; rerunning the seed updates them.
SEED_REVIEWER_PASSWORD=
SEED_ADMIN_PASSWORD=
# The assessors' login: its username, password and role (reviewer or admin; default reviewer).
SEED_ASSESSOR_USERNAME=
SEED_ASSESSOR_PASSWORD=
SEED_ASSESSOR_ROLE=
